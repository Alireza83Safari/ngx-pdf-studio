{
  "name": "@ngx-pdf-studio/source",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for @ngx-pdf-studio — a best-in-class Angular PDF designer & generation library.",
  "license": "MIT",
  "author": "ngx-pdf-studio contributors",
  "homepage": "https://github.com/Alireza83Safari/ngx-pdf-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alireza83Safari/ngx-pdf-studio.git"
  },
  "bugs": {
    "url": "https://github.com/Alireza83Safari/ngx-pdf-studio/issues"
  },
  "workspaces": [
    "packages/pdf-studio/*"
  ],
  "scripts": {
    "test": "jest",
    "test:core": "jest --selectProjects core",
    "lint": "eslint \"packages/**/*.ts\"",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "typecheck": "tsc -b packages/pdf-studio/core/tsconfig.lib.json",
    "demo": "ts-node --project apps/playground/tsconfig.json apps/playground/demo.ts",
    "designer:build": "node apps/playground/designer/build.mjs",
    "build:core": "tsc -b packages/pdf-studio/core/tsconfig.lib.json && node tools/prepare-core-dist.mjs",
    "smoke:tarball": "node tools/smoke-tarball.mjs",
    "build:angular": "ng-packagr -p packages/pdf-studio/angular/ng-package.json -c packages/pdf-studio/angular/tsconfig.lib.json && node tools/prepare-angular-dist.mjs",
    "build": "npm run build:core && npm run build:angular",
    "designer:smoke": "npm run designer:build && node apps/playground/designer/smoke.js",
    "smoke:angular": "node tools/smoke-angular-consumer.mjs",
    "smoke:docs": "node tools/smoke-docs.mjs"
  },
  "devDependencies": {
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/compiler-cli": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.0",
    "@types/qrcode-generator": "^1.0.6",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.6.2",
    "jsqr": "^1.4.0",
    "ng-packagr": "^17.3.0",
    "pdfjs-dist": "^3.11.174",
    "prettier": "^3.3.2",
    "rxjs": "~7.8",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "zone.js": "^0.14.10"
  },
  "engines": {
    "node": ">=18.13.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "bidi-js": "^1.0.3",
    "date-fns": "^4.1.0",
    "date-fns-jalali": "^4.1.0-0",
    "pdf-lib": "^1.17.1",
    "qrcode-generator": "^1.5.2"
  }
}
